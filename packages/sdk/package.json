{
  "name": "@avax-impact/sdk",
  "version": "0.1.0",
  "description": "Transaction attribution SDK for Avalanche, evaluated against a pinned ERC-8021 draft revision",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./legacy": {
      "types": "./dist/src/legacy.d.ts",
      "import": "./dist/src/legacy.js"
    }
  },
  "bin": {
    "avax-impact": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/src/**/*.js' --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=95 dist/test/*.test.js",
    "cli": "node dist/src/cli.js"
  },
  "keywords": [
    "avalanche",
    "erc-8021",
    "attribution",
    "builder-codes"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
