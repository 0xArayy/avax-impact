# Public Avalanche RPC endpoints. Replace them if your provider requires a key.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Use a dedicated, low-value Fuji deployer. Never commit a real key.
DEPLOYER_PRIVATE_KEY=0xYOUR_FUJI_PRIVATE_KEY

# Filled after deployment.
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ATTRIBUTION_DEMO_ADDRESS=0x0000000000000000000000000000000000000000
STRICT_CALLDATA_DEMO_ADDRESS=0x0000000000000000000000000000000000000000

# Builder registration and demo inputs.
BUILDER_CODE=avax-impact
PAYOUT_ADDRESS=0x0000000000000000000000000000000000000000
METADATA_URI=https://github.com/0xArayy/avax-impact
PING_VALUE=41
DEMO_GAS_LIMIT=100000
