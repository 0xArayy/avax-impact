{
  "name": "avax-impact",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @avax-impact/sdk && forge build --offline",
    "test": "npm run test --workspace @avax-impact/sdk && forge test --offline",
    "check": "npm run verify:versions && npm test && npm --prefix demo test && npm --prefix demo run lint && forge fmt --check && bash -n scripts/*.sh && node --check scripts/*.mjs && npm run verify:package",
    "test:contracts": "forge test --offline",
    "test:sdk": "npm run test --workspace @avax-impact/sdk",
    "verify:fuji": "npm run build && node scripts/verify-fuji.mjs",
    "verify:fuji:schema1": "npm run build && node scripts/verify-fuji-schema1.mjs",
    "verify:fuji:all": "npm run build && node scripts/verify-fuji.mjs && node scripts/verify-fuji-schema1.mjs",
    "verify:deployment-sources": "npm run build && node scripts/verify-deployment-sources.mjs",
    "verify:compatibility": "npm run build --workspace @avax-impact/sdk && node scripts/verify-compatibility.mjs",
    "verify:versions": "node scripts/verify-versions.mjs",
    "verify:package": "bash scripts/verify-package.sh",
    "format:contracts": "forge fmt --check"
  },
  "engines": {
    "node": ">=22"
  }
}
